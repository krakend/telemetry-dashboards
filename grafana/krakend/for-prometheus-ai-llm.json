          "editorMode": "code",
          "expr": "sum((sum by(model) (label_replace(increase(krakend_llm_tokens_total{provider=~\"$provider\", app=~\"$app\", instance=~\"$instance\"}[$__range]), \"model\", \"unknown\", \"model\", \"^$\"))\n* on(model)\n(\n  label_replace(vector($cost0), \"model\", \"$model0\", \"\", \"\")\n  or label_replace(vector($cost1), \"model\", \"$model1\", \"\", \"\")\n  or label_replace(vector($cost2), \"model\", \"$model2\", \"\", \"\")\n  or label_replace(vector($cost3), \"model\", \"$model3\", \"\", \"\")\n  or label_replace(vector($cost4), \"model\", \"$model4\", \"\", \"\")\n  or label_replace(vector($cost5), \"model\", \"$model5\", \"\", \"\")\n  or label_replace(vector($cost6), \"model\", \"$model6\", \"\", \"\")\n  or label_replace(vector($cost7), \"model\", \"$model7\", \"\", \"\")\n  or label_replace(vector($cost8), \"model\", \"$model8\", \"\", \"\")\n  or label_replace(vector($cost9), \"model\", \"$model9\", \"\", \"\")\n)\n))",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Estimated costs",
      "type": "stat"
